FROM python:3.12-slim AS base

RUN groupadd -g 10001 app && useradd -u 10001 -g app -m app \
 && mkdir -p /app/dist /app/uploads /tmp \
 && chown -R app:app /app

WORKDIR /app

COPY packages/shared /app/packages/shared
COPY packages/security /app/packages/security
COPY packages/ssg /app/packages/ssg
COPY packages/block-library /app/packages/block-library
COPY apps/api /app/apps/api
COPY pyproject.toml README.md /app/

RUN pip install --no-cache-dir \
      -e /app/packages/shared \
      -e /app/packages/security \
      -e /app/packages/ssg \
      -e /app/packages/block-library \
      -e /app/apps/api

USER app
WORKDIR /app/apps/api
ENV PYTHONPATH=/app/apps/api
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
