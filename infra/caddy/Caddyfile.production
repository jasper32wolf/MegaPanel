{
  email {$CADDY_EMAIL}
  # Bound to the Docker network only: port 2019 is deliberately not published on the host.
  admin 0.0.0.0:2019
}

# The panel uses relative /api calls. Keeping this proxy on the panel origin
# avoids exposing API :8000 and reduces CORS surface for the admin UI.
{$PANEL_DOMAIN} {
  handle /api/* {
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy panel:80
  }

  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options DENY
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
}

{$API_DOMAIN} {
  reverse_proxy api:8000
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Frame-Options DENY
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
}

# Client-site vhosts are added by the Caddy Admin API. Never serve the shared
# release volume from a catch-all host: it contains private candidate builds.
:80 {
  respond "Not found" 404
}
