# VPS-only production configuration. Copying this file does not create a deployable server.
# Store the real file at /opt/site-panel/shared/.env with mode 0600.
APP_ENV=production
PANEL_DOMAIN=panel.your-domain.tld
API_DOMAIN=api.your-domain.tld
CADDY_EMAIL=ops@your-domain.tld
PANEL_PUBLIC_URL=https://panel.your-domain.tld
API_PUBLIC_URL=https://api.your-domain.tld
CORS_ORIGINS=https://panel.your-domain.tld

POSTGRES_DB=site_panel
POSTGRES_USER=site_panel
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgresql+asyncpg://site_panel:replace-with-generated-secret@postgres:5432/site_panel
REDIS_URL=redis://redis:6379/0

APP_SECRET_KEY=replace-with-generated-secret
APP_PEPPER=replace-with-generated-secret
BLIND_INDEX_PEPPER=replace-with-generated-secret
FIELD_ENCRYPTION_KEY=replace-with-generated-secret

CADDY_ADMIN_URL=http://caddy:2019
SITES_ROOT=/app/dist
CADDY_SITES_ROOT=/srv/sites
UPLOADS_ROOT=/app/uploads
DSAR_EXPORTS_ROOT=/app/dsar
DSAR_EXPORT_TTL_HOURS=24
LOG_LEVEL=INFO
