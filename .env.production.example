# VPS-only production configuration. Copying this file does not create a deployable server.
# Store the real file at /opt/site-panel/shared/.env with mode 0600.
APP_ENV=production
PANEL_DOMAIN=panel.your-domain.tld
API_DOMAIN=api.your-domain.tld
CADDY_EMAIL=ops@your-domain.tld
PANEL_PUBLIC_URL=https://panel.your-domain.tld
API_PUBLIC_URL=https://api.your-domain.tld
CORS_ORIGINS=https://panel.your-domain.tld

POSTGRES_DB=site_panel
POSTGRES_USER=site_panel
POSTGRES_PASSWORD=replace-with-generated-secret
DATABASE_URL=postgresql+asyncpg://site_panel:replace-with-generated-secret@postgres:5432/site_panel
REDIS_URL=redis://redis:6379/0

APP_SECRET_KEY=replace-with-generated-secret
APP_PEPPER=replace-with-generated-secret
BLIND_INDEX_PEPPER=replace-with-generated-secret
FIELD_ENCRYPTION_KEY=replace-with-generated-secret

CADDY_ADMIN_URL=http://caddy:2019
SITES_ROOT=/app/dist
CADDY_SITES_ROOT=/srv/sites
UPLOADS_ROOT=/app/uploads
DSAR_EXPORTS_ROOT=/app/dsar
DSAR_EXPORT_TTL_HOURS=24
# Changing telemetry retention requires a new candidate, legal review and explicit publication.
TELEMETRY_RAW_RETENTION_DAYS=30
TELEMETRY_AGGREGATE_RETENTION_DAYS=365

# Optional private lead-email SMTP transport. Keep credentials only in the VPS-local
# shared .env; recipient addresses are never stored in this file or public manifests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Optional panel-to-GitHub control plane. Keep the token only in the VPS-local
# shared .env. It needs permission to dispatch/read Actions workflows, never SSH.
GITHUB_REPOSITORY=owner/repository
GITHUB_CONTROL_TOKEN=replace-with-least-privilege-actions-token
# Optional inbound GitHub workflow_run webhook HMAC secret. Generate independently;
# keep only in the VPS-local shared .env and never add it to Actions secrets or artifacts.
GITHUB_WEBHOOK_SECRET=
GITHUB_API_URL=https://api.github.com
LOG_LEVEL=INFO
