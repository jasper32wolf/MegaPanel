# App
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_PEPPER=change-me-pepper-for-argon2
BLIND_INDEX_PEPPER=change-me-blind-index-pepper
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PANEL_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=site_panel
POSTGRES_USER=site_panel
POSTGRES_PASSWORD=site_panel_dev
DATABASE_URL=postgresql+asyncpg://site_panel:site_panel_dev@localhost:5432/site_panel

# Redis
REDIS_URL=redis://localhost:6379/0

# Caddy
CADDY_ADMIN_URL=http://localhost:2019
SITES_ROOT=./data/sites
CADDY_SITES_ROOT=./data/sites
UPLOADS_ROOT=./data/uploads
DSAR_EXPORTS_ROOT=./data/dsar
DSAR_EXPORT_TTL_HOURS=24

# LLM
LLM_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MICRO_MODEL_DEEPSEEK=deepseek-chat
LLM_MICRO_MODEL_ANTHROPIC=claude-3-5-haiku-latest
LLM_MICRO_MODEL_OPENAI=gpt-4o-mini

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO

# Immutable release / GitHub-managed production deployment
# These are public hostnames and an ACME contact, not credentials.
# Real secrets stay only in /opt/site-panel/shared/.env, backup.env and GitHub Environments.
PANEL_DOMAIN=panel.example.com
API_DOMAIN=api.example.com
CADDY_EMAIL=ops@example.com

# Optional panel-to-GitHub control plane. Store a real token only in the VPS-local
# /opt/site-panel/shared/.env; do not commit it or expose it through the API.
GITHUB_REPOSITORY=
GITHUB_CONTROL_TOKEN=
GITHUB_API_URL=https://api.github.com
